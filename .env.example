APP_NAME=BakeHouse
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/BakeHouse/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bakehouse
DB_USERNAME=root
DB_PASSWORD=

VIETQR_BANK_ID=970436
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=BAKEHOUSE
SHIPPING_FEE=30000

AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Azure Blob Storage: lưu ảnh upload và ảnh seed (để trống = lưu vào public/uploads)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=

# Chatbot: điểm tương đồng tối thiểu (0-1) để coi là sản phẩm phù hợp; tổng số lượt chat tối đa mỗi giờ cho cả site
CHATBOT_MIN_SCORE=0.30
CHATBOT_GLOBAL_LIMIT=600
